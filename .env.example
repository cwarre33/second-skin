# Copy to .env and fill in. Never commit .env.

# NVIDIA NIM API key (server-side only; used by demo/api/improve.js). Never ship
# to the browser bundle or extension code.
NVIDIA_API_KEY=

# --- Analytics (demo public site) ---
# GoatCounter site code (the subdomain before .goatcounter.com). Optional but
# recommended for the feedback protocol (#14). Leave blank to disable.
NEXT_PUBLIC_GOATCOUNTER_CODE=
# Microsoft Clarity project id. Optional but recommended for the feedback
# protocol (#14). Leave blank to disable. Mask sensitive form fields (see
# docs/gtm/feedback-protocol.md) before enabling.
NEXT_PUBLIC_CLARITY_PROJECT_ID=