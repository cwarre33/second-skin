# Copy to .env.local and fill in only for local development.

# Server-side only — never expose to the client bundle.
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public by design — the Chrome extension ID is not a secret.
NEXT_PUBLIC_EXTENSION_ID=abcdefghijklmnopqrstuvwxyzabcdef

# Analytics (public by design).
NEXT_PUBLIC_GOATCOUNTER_CODE=second-skin
NEXT_PUBLIC_CLARITY_PROJECT_ID=xxxxxxxxxx
