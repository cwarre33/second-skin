{
  "manifest_version": 3,
  "name": "Second Skin",
  "version": "1.0.0",
  "description": "Local-first browser extension to cross-list resale inventory across Depop and Grailed.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:11434/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Second Skin: cross-list this item"
  },
  "options_page": "dashboard.html",
  "externally_connectable": {
    "matches": [
      "http://localhost:3000/*",
      "http://127.0.0.1:3000/*",
      "https://second-skin-zeta.vercel.app/*"
    ]
  },
  "content_scripts": [
    {
      "matches": ["*://*.depop.com/*"],
      "js": ["shared.js", "content_depop.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://*.grailed.com/*"],
      "js": ["shared.js", "content_grailed.js"],
      "run_at": "document_end"
    }
  ]
}
